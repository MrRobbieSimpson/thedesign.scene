# PostgreSQL (Neon / Supabase / local)
DATABASE_URL=

# Clerk auth — https://dashboard.clerk.com
# Enable Google, X (Twitter), and LinkedIn social connections.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public site URL (custom domain)
NEXT_PUBLIC_SITE_URL=https://sitwithdesign.online

# Weekly digest (Resend) — https://resend.com
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@sitwithdesign.online
CRON_SECRET=

# Admin allowlist — comma-separated Clerk user ids (and optional emails).
# Empty allowlist = nobody can access /admin.
ADMIN_CLERK_USER_IDS=
ADMIN_EMAILS=

# Article image uploads — Vercel Blob (Hobby free tier is fine to start).
# Vercel → Storage → Create Blob store → copy token.
BLOB_READ_WRITE_TOKEN=
