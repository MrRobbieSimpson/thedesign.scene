# PostgreSQL (Neon / Supabase / local)
DATABASE_URL=

# Clerk auth — https://dashboard.clerk.com
# Production launch: use pk_live_ / sk_live_ (not pk_test_ / sk_test_).
# Enable Google, X (Twitter), and LinkedIn on the Production instance.
# Allowed origins / redirects must include https://sitwithdesign.online
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Public site URL (custom domain)
NEXT_PUBLIC_SITE_URL=https://sitwithdesign.online

# Weekly digest (Resend) — https://resend.com
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@sitwithdesign.online
CRON_SECRET=

# Admin allowlist — comma-separated Clerk user ids (and optional emails).
# Empty allowlist = nobody can access /admin.
ADMIN_CLERK_USER_IDS=
ADMIN_EMAILS=

# Article image uploads — Vercel Blob (Hobby free tier is fine to start).
# Vercel → Storage → Create Blob store → copy token.
BLOB_READ_WRITE_TOKEN=

# Only after confirming pk_live_ on production (silences false Clerk console warning)
# NEXT_PUBLIC_CLERK_UNSAFE_DISABLE_DEVELOPMENT_MODE_CONSOLE_WARNING=true
